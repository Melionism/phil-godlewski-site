# Статика Astro (dist/). TLS терминируется снаружи (Cloudflare / reverse-proxy),
# поэтому Caddy слушает plain HTTP на :8080 и не запрашивает сертификаты.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges 127.0.0.1/32 ::1/128
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:8080 {
	root * /srv

	log {
		format json
		output stdout
	}

	# Домен: philgodlewski.link (www -> apex)
	@www host www.philgodlewski.link
	@trailing path_regexp trailing ^(.+)/$
	@asset path /_astro/*
	@static path *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff *.woff2 *.pdf
	@page not path /_astro/* *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff *.woff2 *.pdf

	route {
		respond /healthz "ok" 200
		redir @www https://philgodlewski.link{uri} permanent
		redir @trailing {re.trailing.1} permanent
		# /index.html — дубль главной; /blog/post.html — дубль /blog/post
		redir /index.html / permanent
		@html path_regexp html ^(/.+)\.html$
		redir @html {re.html.1} permanent
		# Старые адреса статей (frontmatter aliases) — генерируется при сборке, см. src/pages/redirects.caddy.ts
		import /etc/caddy/redirects.caddy

		encode zstd gzip

		header @asset Cache-Control "public, max-age=31536000, immutable"
		header @static Cache-Control "public, max-age=300, must-revalidate"
		header @page Cache-Control "public, max-age=0, must-revalidate"
		header {
			-Server
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			# Вместо X-Frame-Options SAMEORIGIN: Вебвизор и карты кликов Метрики показывают сайт в iframe.
			# Список доменов — yandex.ru/support/metrica/ru/code/install-counter-csp + webvisor.com
			Content-Security-Policy "frame-ancestors 'self' https://webvisor.com https://*.webvisor.com https://metrika.yandex.ru https://metrika.yandex.by https://metrika.yandex.kz https://metrika.yandex.uz https://metrika.yandex.com https://metrika.yandex.com.tr https://metrika.yandex https://metrika.ya.ru https://metrica.yandex.ru https://metrica.yandex.by https://metrica.yandex.kz https://metrica.yandex.com https://metrica.yandex.com.tr https://metrica.yandex https://metrica.ya.ru https://metr.yandex.ru https://metr.yandex.by https://metr.yandex.kz https://metr.yandex.com https://metr.yandex.com.tr https://analytics.yandex.ru https://analytics.yandex.by https://analytics.yandex.kz https://analytics.yandex.com https://analytics.yandex.com.tr"
		}

		try_files {path}/index.html {path}.html {path}
		file_server
	}

	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
