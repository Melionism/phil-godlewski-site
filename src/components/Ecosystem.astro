---
import { ecosystem } from '../content/site';
import { imgSize } from '../lib/imgSize';
import Icons from './Icons.astro';
const bg = imgSize(ecosystem.background);
---
<section class="section ecosystem" id="ecosystem">
  <div class="ecosystem__bg" aria-hidden="true">
    <img src={ecosystem.background} alt="" width={bg.width} height={bg.height} loading="lazy" decoding="async" />
  </div>
  <div class="wrap ecosystem__in">
    <div class="eco__head reveal">
      <div>
        <p class="label">{ecosystem.label}</p>
        <h2 class="h2">{ecosystem.heading}</h2>
      </div>
      <p class="lead">{ecosystem.intro}</p>
    </div>
    <ul class="eco__grid">
      {ecosystem.list.map((p, i) => {
        const size = p.logo ? imgSize(p.logo) : null;
        const Tag = p.url ? 'a' : 'div';
        return (
          <li class="reveal" style={`transition-delay:${i * 80}ms`}>
            <Tag class="card eco__card" href={p.url ?? undefined} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener' : undefined}>
              <div class:list={['eco__logo', { 'eco__logo--light': p.light }]}>
                {p.logo && size ? (
                  <img src={p.logo} alt={p.name} width={size.width} height={size.height} loading="lazy" />
                ) : (
                  <span class="eco__mark">{p.name.slice(0, 1)}</span>
                )}
              </div>
              <div class="eco__body">
                <span class="eco__tag">{p.tag}</span>
                <h3 class="h3">{p.name}</h3>
                <p class="eco__desc">{p.desc}</p>
                {p.url ? (
                  <span class="eco__link">{p.urlLabel ?? 'Open'} <Icons name="external" /></span>
                ) : (
                  <span class="eco__link eco__link--soon">Link coming soon</span>
                )}
              </div>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .ecosystem { position: relative; overflow: hidden; }
  .ecosystem__bg {
    position: absolute;
    inset: -6% 0;
    pointer-events: none;
    opacity: 0.42;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
  }
  .ecosystem__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .ecosystem__in { position: relative; }
  .eco__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: 48px;
  }
  .eco__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .eco__card { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
  .eco__logo {
    display: grid;
    place-items: center;
    height: 190px;
    padding: 36px;
    background:
      radial-gradient(circle at 50% 100%, rgba(200, 24, 42, 0.18), transparent 60%),
      #0b0b0f;
    border-bottom: 1px solid var(--line);
  }
  .eco__logo--light { background: var(--light); }
  .eco__logo img { max-height: 84px; width: auto; max-width: 240px; object-fit: contain; }
  .eco__mark {
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--light);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 44px;
    box-shadow: 0 0 40px -10px var(--accent-glow);
  }
  .eco__body { padding: 26px 28px 28px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .eco__tag { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-2); }
  .eco__desc { color: var(--ink-2); flex: 1; }
  .eco__link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 14px; margin-top: 8px; color: var(--ink); }
  .eco__link :global(svg) { width: 16px; height: 16px; transition: transform 0.3s var(--ease); }
  .eco__card:hover .eco__link :global(svg) { transform: translate(2px, -2px); }
  .eco__link--soon { color: var(--ink-3); }

  @media (max-width: 820px) {
    .eco__head { grid-template-columns: 1fr; }
    .eco__grid { grid-template-columns: 1fr; }
  }
</style>
