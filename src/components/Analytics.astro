---
/**
 * GA4 + Consent Mode v2 + события блога. Выводится, только если в site.ts задан analytics.gaId.
 *
 * Согласие: для EEA/UK/CH аналитика по умолчанию выключена (analytics_storage: denied),
 * пока посетитель не нажмёт Accept в баннере; для остальных регионов — включена.
 * Рекламные хранилища выключены везде — рекламы на сайте нет.
 *
 * События (имена GA4):
 *   social_click {channel, placement} — переход в канал Фила (Instagram, Threads, Rumble, Telegram, Locals)
 *   cta_click {placement, link_url}     — клик по элементу с data-track="cta"
 *   share {method, item_id}             — кнопки «поделиться» (data-track="share")
 *   internal_link_click {link_url}      — переход по внутренней ссылке блога
 *   read_75 {item_id}                   — дочитывание статьи до 75%
 *   search {search_term}                — запрос в поиске по блогу (шлёт страница поиска)
 * placement берётся из ближайшего data-placement (nav, footer, follow, article_cta…).
 */
import { analytics, socials } from '../content/site';

const gaId = analytics.gaId;
// hostname → ключ канала, чтобы ловить любые ссылки на каналы без ручной разметки
const channelHosts = Object.fromEntries(Object.entries(socials).map(([key, s]) => [new URL(s.url).hostname.replace(/^www\./, ''), key]));
// EEA + UK + CH (ISO 3166-1 alpha-2) — регионы, где без согласия аналитика выключена
const consentRegions = ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH'];
---
{gaId && (
  <>
    <script is:inline define:vars={{ gaId, consentRegions }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      const off = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' };
      gtag('consent', 'default', { ...off, analytics_storage: 'denied', region: consentRegions, wait_for_update: 500 });
      gtag('consent', 'default', { ...off, analytics_storage: 'granted' });
      let choice = null;
      try { choice = localStorage.getItem('pg-consent'); } catch {}
      if (choice) gtag('consent', 'update', { analytics_storage: choice === 'granted' ? 'granted' : 'denied' });
      gtag('js', new Date());
      gtag('config', gaId);
      // gtag.js грузим после onload, чтобы не мешать первой отрисовке (ТЗ, PERF-7); события копятся в dataLayer
      addEventListener('load', () => {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);
      });
    </script>

    <div class="consent" id="consent" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
      <p>We use Google Analytics cookies to understand which articles are read. <a href="/privacy">Privacy</a></p>
      <div class="consent__actions">
        <button type="button" class="btn btn--ghost" data-consent="denied">Decline</button>
        <button type="button" class="btn btn--primary" data-consent="granted">Accept</button>
      </div>
    </div>

    <script is:inline define:vars={{ channelHosts }}>
      (() => {
        const gtag = window.gtag;
        // Баннер — только посетителям из европейских часовых поясов, которые ещё не выбрали
        const box = document.getElementById('consent');
        let stored = null;
        try { stored = localStorage.getItem('pg-consent'); } catch {}
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (box && !stored && tz.startsWith('Europe/')) box.hidden = false;
        box?.addEventListener('click', (e) => {
          const value = e.target.closest('[data-consent]')?.dataset.consent;
          if (!value) return;
          try { localStorage.setItem('pg-consent', value); } catch {}
          gtag('consent', 'update', { analytics_storage: value });
          box.hidden = true;
        });

        const placementOf = (el) => el.closest('[data-placement]')?.dataset.placement || 'page';
        document.addEventListener('click', (e) => {
          const a = e.target.closest('a[href]');
          if (!a) return;
          const url = new URL(a.href, location.href);
          const tracked = a.dataset.track;
          if (tracked === 'share') return gtag('event', 'share', { method: a.dataset.method, item_id: location.pathname });
          const channel = channelHosts[url.hostname.replace(/^www\./, '')];
          if (channel) gtag('event', 'social_click', { channel, placement: placementOf(a), link_url: url.href });
          if (tracked === 'cta') gtag('event', 'cta_click', { placement: placementOf(a), link_url: url.href });
          else if (url.origin === location.origin && location.pathname.startsWith('/blog') && url.pathname !== location.pathname)
            gtag('event', 'internal_link_click', { link_url: url.pathname });
        });

        // Дочитывание: низ статьи прошёл 75% её высоты
        const article = document.querySelector('[data-article]');
        if (article) {
          const onScroll = () => {
            const r = article.getBoundingClientRect();
            if (innerHeight - r.top >= r.height * 0.75) {
              gtag('event', 'read_75', { item_id: location.pathname });
              removeEventListener('scroll', onScroll);
            }
          };
          addEventListener('scroll', onScroll, { passive: true });
        }
      })();
    </script>
  </>
)}

<style>
  .consent {
    position: fixed;
    inset: auto 16px 16px;
    z-index: 1001;
    max-width: 560px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-2);
    background: var(--surface-2);
    box-shadow: var(--shadow-lg);
    font-size: 14px;
    color: var(--ink-2);
  }
  .consent[hidden] { display: none; }
  .consent p { flex: 1 1 260px; }
  .consent a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .consent__actions { display: flex; gap: 8px; }
  .consent .btn { padding: 11px 18px; min-height: 44px; }
</style>
