---
import { focus } from '../content/site';
import { imgSize } from '../lib/imgSize';
const bg = imgSize(focus.background);
---
<section class="section focus" id="focus">
  <div class="focus__bg" aria-hidden="true">
    <img src={focus.background} alt="" width={bg.width} height={bg.height} loading="lazy" decoding="async" />
  </div>
  <div class="wrap focus__in">
    <div class="reveal">
      <p class="label">{focus.label}</p>
      <h2 class="h2">{focus.heading}</h2>
    </div>
    <ol class="focus__list">
      {focus.items.map((f, i) => (
        <li class="reveal" style={`transition-delay:${i * 80}ms`}>
          <span class="focus__num">{['I', 'II', 'III', 'IV', 'V', 'VI'][i]}</span>
          <h3 class="h3">{f.title}</h3>
          <p class="muted">{f.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .focus { position: relative; overflow: hidden; }
  .focus__bg {
    position: absolute;
    inset: -10% 0;
    pointer-events: none;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 25%, #000 75%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 25%, #000 75%, transparent 100%);
  }
  .focus__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .focus__in { position: relative; }
  .focus__list {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
  }
  .focus__list li {
    position: relative;
    padding: 30px 24px 34px 0;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .focus__list li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent-2);
    box-shadow: 0 0 12px var(--accent-2);
    transition: width 0.6s var(--ease);
  }
  .focus__list li:hover::before { width: calc(100% - 24px); }
  .focus__num { font-family: var(--font-display); font-style: italic; font-size: 20px; color: var(--accent-2); }
  .focus__list .muted { color: #b3b7bf; }
  @media (max-width: 900px) { .focus__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; } }
  @media (max-width: 480px) { .focus__list { grid-template-columns: 1fr; } }
</style>
