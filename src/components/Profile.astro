---
import { profile } from '../content/site';
import { imgSize } from '../lib/imgSize';
const art = imgSize(profile.image);
---
<section class="section" id="profile">
  <div class="wrap profile reveal">
    <div class="profile__text">
      <p class="label">{profile.label}</p>
      <h2 class="h2">{profile.heading}</h2>
      <p class="lead">{profile.text}</p>
      <ul class="profile__tags" aria-label="Areas">
        {profile.tags.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <figure class="profile__art">
      <img src={profile.image} alt="" width={art.width} height={art.height} loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 6vw, 96px);
    align-items: center;
    padding-top: var(--section);
    border-top: 1px solid var(--line);
  }
  .profile__text .lead { margin-top: 22px; }
  .profile__tags { list-style: none; padding: 0; margin: 30px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .profile__tags li {
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .profile__art {
    margin: 0;
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    outline: 1px solid var(--line);
    box-shadow: var(--shadow-lg), 0 0 140px -40px var(--accent-glow);
    aspect-ratio: 3 / 4;
    background: #000;
  }
  .profile__art img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .profile__art:hover img { transform: scale(1.03); }
  @media (max-width: 820px) {
    .profile { grid-template-columns: 1fr; }
    .profile__art { order: -1; max-width: 420px; }
  }
</style>
