---
import { atom } from '../content/site';
import { imgSize } from '../lib/imgSize';
import Icons from './Icons.astro';
const logo = imgSize(atom.logo);
const tile = imgSize(atom.background);
---
<section class="section" id="atom">
  <div class="wrap">
    <div class="atom reveal">
      <div class="atom__brand">
        <img class="atom__tile" src={atom.background} alt="" width={tile.width} height={tile.height} loading="lazy" decoding="async" aria-hidden="true" />
        <img class="atom__logo" src={atom.logo} alt={atom.logoAlt} width={logo.width} height={logo.height} loading="lazy" />
      </div>
      <div class="atom__body">
        <p class="label">{atom.label}</p>
        <h2 class="h2">{atom.heading}</h2>
        <p class="atom__text">{atom.text}</p>
        <ul class="atom__verticals">
          {atom.verticals.map((v) => (
            <li>
              <span class="atom__v-name">{v.name}</span>
              <span class="atom__v-project">{v.project}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn--accent" href={atom.url} target="_blank" rel="noopener">{atom.urlLabel} <Icons name="external" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .atom {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    border: 1px solid var(--line);
    border-radius: 24px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .atom__brand {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(40px, 6vw, 80px);
    background:
      radial-gradient(circle at 50% 50%, rgba(200, 24, 42, 0.35), transparent 60%),
      #0a0a0e;
    border-right: 1px solid var(--line);
  }
  .atom__brand::after {
    content: '';
    position: absolute;
    inset: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    pointer-events: none;
  }
  .atom__tile { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; opacity: 0.75; }
  .atom__brand::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 60% at 50% 50%, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.15) 100%); }
  .atom__logo { position: relative; width: min(100%, 340px); filter: drop-shadow(0 4px 30px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 24px rgba(255, 255, 255, 0.12)); }
  .atom__body { padding: clamp(36px, 5vw, 72px); }
  .atom__body .h2 { font-size: clamp(32px, 4vw, 50px); max-width: 20ch; }
  .atom__text { margin-top: 18px; color: var(--ink-2); font-size: 18px; }
  .atom__verticals {
    list-style: none;
    padding: 0;
    margin: 32px 0 36px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .atom__verticals li { padding: 16px 18px; background: var(--surface); display: grid; gap: 4px; }
  .atom__v-name { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-2); }
  .atom__v-project { font-family: var(--font-display); font-weight: 600; font-size: 22px; }

  @media (max-width: 820px) {
    .atom { grid-template-columns: 1fr; }
    .atom__brand { padding: 44px; border-right: 0; border-bottom: 1px solid var(--line); }
    .atom__logo { width: min(70%, 260px); }
  }
  @media (max-width: 480px) { .atom__verticals { grid-template-columns: 1fr; } }
</style>
