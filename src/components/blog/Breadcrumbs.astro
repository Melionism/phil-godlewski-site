---
/** Хлебные крошки (ТЗ, FR-9). Последний пункт — текущая страница, без ссылки. JSON-LD — breadcrumbSchema() в lib/schema.ts */
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { margin-bottom: 32px; font-size: 14px; color: var(--ink-3); }
  .crumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: 6px; color: var(--ink-3); }
  .crumbs a { color: var(--ink-2); font-weight: 600; }
  .crumbs a:hover { color: var(--ink); }
  .crumbs span { color: var(--ink-3); }
</style>
