---
import type { GetStaticPaths } from 'astro';
import ListPage from '../../components/blog/ListPage.astro';
import PostGrid from '../../components/blog/PostGrid.astro';
import { getPosts, PAGE_SIZE } from '../../lib/blog';
import { blog } from '../../content/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  // Нет постов — страницы /blog не существует (paginate с пустым массивом всё равно создаёт страницу)
  if (posts.length === 0) return [];
  return paginate(posts, { pageSize: PAGE_SIZE, props: { posts } });
}) satisfies GetStaticPaths;

const { page, posts } = Astro.props;
// Recommended — только на первой странице, до трёх постов с featured: true
const featured = page.currentPage === 1 ? posts.filter((p) => p.data.featured).slice(0, 3) : [];
---
<ListPage
  page={page}
  posts={posts}
  title={blog.title}
  description={blog.description}
  label={blog.label}
  heading={blog.heading}
  lead={blog.description}
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }]}
  placement="blog_feed"
>
  {featured.length > 0 && (
    <section class="blog-section" slot="top" aria-labelledby="featured-title">
      <h2 class="blog-section__title" id="featured-title">Recommended</h2>
      <PostGrid posts={featured} headingLevel="h3" />
    </section>
  )}
</ListPage>
