---
import type { GetStaticPaths } from 'astro';
import ListPage from '../../../../components/blog/ListPage.astro';
import { getPosts, getTags, PAGE_SIZE, TAG_INDEX_MIN, tagUrl } from '../../../../lib/blog';
import { site } from '../../../../content/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  // Страница есть только у тегов из списка, на которые ссылается хотя бы одна статья
  return (await getTags(posts)).flatMap(({ tag, posts: tagged }) =>
    paginate(tagged, { pageSize: PAGE_SIZE, params: { slug: tag.id }, props: { tag, total: tagged.length, posts } }),
  );
}) satisfies GetStaticPaths;

const { page, tag, total, posts } = Astro.props;
const name = tag.data.name;
---
<ListPage
  page={page}
  posts={posts}
  title={`Articles tagged “${name}” — ${site.name} Blog`}
  description={tag.data.description ?? `Articles by ${site.name} tagged ${name}: notes on technology, sports, AI, design and the ATOM ecosystem.`}
  label="Tag"
  heading={`#${name}`}
  lead={tag.data.description}
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }, { name: `#${name}`, href: tagUrl(tag.id) }]}
  noindex={total < TAG_INDEX_MIN}
  placement="tag_feed"
/>
