---
import type { GetStaticPaths } from 'astro';
import ListPage from '../../../../components/blog/ListPage.astro';
import { getPosts, getTags, PAGE_SIZE, TAG_INDEX_MIN, tagUrl } from '../../../../lib/blog';
import { site } from '../../../../content/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return [...getTags(posts)].flatMap(([slug, tag]) =>
    paginate(tag.posts, { pageSize: PAGE_SIZE, params: { slug }, props: { slug, tagName: tag.name, total: tag.posts.length, posts } }),
  );
}) satisfies GetStaticPaths;

const { page, slug, tagName, total, posts } = Astro.props;
---
<ListPage
  page={page}
  posts={posts}
  title={`Articles tagged “${tagName}” — ${site.name} Blog`}
  description={`Articles by ${site.name} tagged ${tagName}: notes on technology, sports, AI, design and the ATOM ecosystem.`}
  label="Tag"
  heading={`#${tagName}`}
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }, { name: `#${tagName}`, href: tagUrl(slug) }]}
  noindex={total < TAG_INDEX_MIN}
  placement="tag_feed"
/>
