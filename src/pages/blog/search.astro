---
/**
 * Поиск по блогу (ТЗ, FR-6). Индекс строит Pagefind после сборки (src/integrations/postbuild.mjs)
 * только по статьям (data-pagefind-body). Страница закрыта от индексации.
 * В `npm run dev` индекса нет — проверять через `npm run build && npm run preview`.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/blog/Breadcrumbs.astro';
import CategoryChips from '../../components/blog/CategoryChips.astro';
import { getPosts, postUrl } from '../../lib/blog';
import { site } from '../../content/site';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---
<Base title={`Search — ${site.name} Blog`} description={`Search articles by ${site.name} on technology, sports, AI, design and the ATOM ecosystem.`} path="/blog/search" noindex>
  <Nav />
  <main class="wrap blog-page" id="main">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }, { name: 'Search', href: '/blog/search' }]} />
    <header class="blog-page__head">
      <p class="label">Blog</p>
      <h1 class="h2">Search</h1>
    </header>
    <form class="search" role="search" action="/blog/search">
      <label class="sr-only" for="q">Search articles</label>
      <input id="q" name="q" type="search" placeholder="Search articles, topics, tags…" autocomplete="off" />
    </form>
    <p class="search__status muted" id="status" aria-live="polite"></p>
    <ol class="search__results" id="results"></ol>

    <section class="blog-section search__empty" id="empty" hidden>
      <h2 class="blog-section__title">Try a category or a recent article</h2>
      <CategoryChips posts={posts} withAll={false} />
      <ul class="search__latest">
        {latest.map((p) => <li><a href={postUrl(p.id)}>{p.data.title}</a></li>)}
      </ul>
    </section>
  </main>
  <Footer />
</Base>

<!-- Индекс Pagefind появляется только после сборки: импорт держим вне Vite, иначе бандлер его переписывает -->
<script is:inline>
  window.loadPagefind = () => import('/pagefind/pagefind.js');
</script>

<script>
  type Hit = { url: string; excerpt: string; meta: { title?: string } };
  type Pagefind = {
    search: (q: string) => Promise<{ results: { data: () => Promise<Hit> }[] }>;
  };

  const input = document.getElementById('q') as HTMLInputElement;
  const status = document.getElementById('status')!;
  const list = document.getElementById('results')!;
  const empty = document.getElementById('empty')!;
  let pagefind: Pagefind | null = null;
  let timer = 0;
  let lastTracked = '';

  async function load() {
    if (pagefind) return pagefind;
    try {
      pagefind = await (window as unknown as { loadPagefind: () => Promise<Pagefind> }).loadPagefind();
    } catch {
      status.textContent = 'Search index is not available.';
    }
    return pagefind;
  }

  function render(hits: Hit[], q: string) {
    list.replaceChildren(
      ...hits.map((h) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = h.url.replace(/\.html$/, '');
        a.className = 'search__title';
        a.textContent = h.meta.title ?? h.url;
        const p = document.createElement('p');
        // excerpt от Pagefind — текст статьи с <mark> вокруг совпадений
        p.innerHTML = h.excerpt;
        li.append(a, p);
        return li;
      }),
    );
    status.textContent = q ? (hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'} for “${q}”` : `Nothing found for “${q}”.`) : '';
    empty.hidden = !q || hits.length > 0;
  }

  async function run(q: string) {
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!q) return render([], '');
    const pf = await load();
    if (!pf) return;
    const res = await pf.search(q);
    const hits = await Promise.all(res.results.slice(0, 20).map((r) => r.data()));
    render(hits, q);
    if (q !== lastTracked) {
      lastTracked = q;
      (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', 'search', { search_term: q });
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => run(input.value.trim()), 250);
  });
  input.form?.addEventListener('submit', (e) => {
    e.preventDefault();
    run(input.value.trim());
  });
  const initial = new URL(location.href).searchParams.get('q') ?? '';
  if (initial) {
    input.value = initial;
    run(initial);
  } else {
    input.focus();
  }
</script>

<style>
  .search input {
    width: 100%;
    max-width: 760px;
    min-height: 56px;
    padding: 14px 22px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    font-size: 18px;
  }
  .search input:focus { outline: 2px solid var(--accent-2); outline-offset: 2px; }
  .search__status { margin-top: 20px; }
  .search__results { list-style: none; padding: 0; margin: 24px 0 0; max-width: 820px; }
  .search__results :global(li) { padding: 20px 0; border-top: 1px solid var(--line); }
  .search__results :global(.search__title) { font-family: var(--font-display); font-size: 26px; font-weight: 600; }
  .search__results :global(.search__title:hover) { color: var(--accent-2); }
  .search__results :global(p) { margin-top: 8px; color: var(--ink-2); }
  .search__results :global(mark) { background: rgba(255, 59, 74, 0.25); color: var(--ink); border-radius: 3px; padding: 0 2px; }
  .search__empty[hidden] { display: none; }
  .search__latest { margin-top: 24px; padding-left: 20px; display: grid; gap: 10px; }
  .search__latest a { font-weight: 700; }
  .search__latest a:hover { color: var(--accent-2); }
</style>
