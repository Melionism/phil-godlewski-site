---
import type { GetStaticPaths } from 'astro';
import { getEntry, getEntries, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/blog/Breadcrumbs.astro';
import FollowCta from '../../components/blog/FollowCta.astro';
import ShareLinks from '../../components/blog/ShareLinks.astro';
import PostGrid from '../../components/blog/PostGrid.astro';
import { getPosts, relatedPosts, readingTime, fmtDate, postUrl, categoryUrl, tagUrl, authorUrl } from '../../lib/blog';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { site } from '../../content/site';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, related: relatedPosts(post, posts) } }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
// Оглавление: H2/H3 статьи + FAQ; показываем, если разделов (H2) хотя бы три
const toc = [
  ...headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ depth: h.depth, slug: h.slug, text: h.text })),
  ...(data.faq.length ? [{ depth: 2, slug: 'faq-title', text: 'Frequently asked questions' }] : []),
];
const showToc = toc.filter((h) => h.depth === 2).length >= 3;
const category = (await getEntry(data.category))!;
const author = (await getEntry(data.author))!;
const tags = await getEntries(data.tags);
const tagNames = tags.map((t) => t.data.name);
const origin = Astro.site ? Astro.site.origin : '';
const url = postUrl(post.id);
const minutes = readingTime(post.body);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const updated = data.updatedDate && data.updatedDate > data.pubDate ? data.updatedDate : undefined;
// <title> до 60 символов (ТЗ, SEO-8): имя сайта дописываем, только если влезает
const baseTitle = data.seoTitle ?? data.title;
const pageTitle = `${baseTitle} — ${site.name}`.length <= 60 ? `${baseTitle} — ${site.name}` : baseTitle;

// OG-картинка 1200×630 из обложки (ТЗ, RD-5); без обложки — общая картинка сайта
const og = data.cover ? (await getImage({ src: data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src : site.ogImage;
const ogAbs = /^https?:/.test(og) ? og : origin + og;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: category.data.name, href: categoryUrl(category.id) },
  { name: data.title, href: url },
];
const jsonLd = [
  articleSchema(origin, { url, title: data.title, description: data.description, image: ogAbs, published: data.pubDate, modified: updated, section: category.data.name, tags: tagNames, words }),
  breadcrumbSchema(origin, crumbs),
  ...(data.faq.length ? [faqSchema(data.faq)] : []),
];
---
<Base
  title={pageTitle}
  description={data.description}
  path={url}
  ogImage={og}
  ogType="article"
  article={{ published: data.pubDate, modified: updated, section: category.data.name, tags: tagNames }}
  jsonLd={jsonLd}
  noindex={data.noindex}
>
  <Nav />
  <main class="wrap article" id="main">
    <Breadcrumbs items={crumbs} />
    <article data-article data-pagefind-body>
      <header class="article__head">
        <p class="article__meta">
          <a class="article__cat" href={categoryUrl(category.id)} data-pagefind-filter="category">{category.data.name}</a>
          <time datetime={data.pubDate.toISOString()}>{fmtDate(data.pubDate)}</time>
          <span>{minutes} min read</span>
        </p>
        <h1 class="h2 article__title" data-pagefind-meta="title">{data.title}</h1>
        <p class="lead">{data.description}</p>
        <p class="article__byline">
          By <a href={authorUrl(author.id)} rel="author">{author.data.name}</a>
          {updated && <> · Updated <time datetime={updated.toISOString()}>{fmtDate(updated)}</time></>}
        </p>
      </header>
      {data.cover && (
        <figure class="article__cover">
          <Image src={data.cover} alt={data.coverAlt ?? ''} widths={[640, 960, 1280, 1640]} sizes="(max-width: 860px) 100vw, 820px" loading="eager" fetchpriority="high" data-pagefind-meta="image[src]" />
        </figure>
      )}
      {showToc && (
        <nav class="toc" aria-labelledby="toc-title" data-pagefind-ignore>
          <details open>
            <summary id="toc-title">Contents</summary>
            <ol>
              {toc.map((h) => (
                <li class:list={{ 'toc__sub': h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}
      <div class="article__body prose">
        <Content />
      </div>

      {data.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently asked questions</h2>
          {data.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      {tags.length > 0 && (
        <ul class="chips article__tags" aria-label="Tags">
          {tags.map((t) => <li><a class="chip" href={tagUrl(t.id)}>#{t.data.name}</a></li>)}
        </ul>
      )}
    </article>

    <div class="article__after" data-pagefind-ignore>
      <ShareLinks url={origin + url} title={data.title} />

      <a class="card author" href={authorUrl(author.id)}>
        <Image class="author__photo" src={author.data.photo} alt={author.data.photoAlt} width={96} height={96} loading="lazy" />
        <span>
          <span class="author__name">{author.data.name}</span>
          <span class="author__pos">{author.data.position}</span>
          <span class="author__short">{author.data.short}</span>
        </span>
      </a>

      <FollowCta primary={data.cta} placement="article_cta" />
    </div>

    {related.length > 0 && (
      <section class="article__related" aria-labelledby="related-title" data-pagefind-ignore>
        <div class="article__related-head">
          <h2 class="blog-section__title" id="related-title">Related articles</h2>
          <a class="btn btn--ghost" href={categoryUrl(category.id)}>More in {category.data.name}</a>
        </div>
        <PostGrid posts={related} headingLevel="h3" />
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .article { padding-block: clamp(40px, 7vh, 88px) var(--section); }
  .article > article, .article__after { max-width: 820px; }
  .article__meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--accent-2); }
  .article__meta span { color: var(--ink-3); }
  .article__cat { font-family: var(--font); font-style: normal; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); border: 1px solid var(--line-2); border-radius: 999px; padding: 6px 12px; }
  .article__cat:hover { border-color: var(--ink); }
  .article__title { margin-top: 16px; max-width: none; }
  .article__head .lead { margin-top: 20px; }
  .article__byline { margin-top: 18px; font-size: 15px; color: var(--ink-2); }
  .article__byline a { color: var(--ink); font-weight: 700; }
  .article__cover { margin: 40px 0 0; border-radius: 6px; overflow: hidden; outline: 1px solid var(--line); }
  .article__cover :global(img) { width: 100%; height: auto; }
  .article__body { margin-top: 44px; }
  .article__body :global(h2), .article__body :global(h3), .faq h2 { scroll-margin-top: 96px; }

  .toc { margin-top: 40px; border: 1px solid var(--line-2); border-radius: var(--radius-sm); background: var(--bg-2); }
  .toc summary { cursor: pointer; min-height: 52px; display: flex; align-items: center; padding: 0 22px; font-family: var(--font-display); font-size: 22px; font-weight: 600; }
  .toc ol { list-style: none; margin: 0; padding: 0 22px 18px; display: grid; gap: 2px; counter-reset: toc; }
  .toc li:not(.toc__sub) { counter-increment: toc; }
  .toc li a { display: flex; gap: 12px; padding: 7px 0; color: var(--ink-2); font-size: 16px; line-height: 1.4; }
  .toc li:not(.toc__sub) a::before { content: counter(toc, decimal-leading-zero); flex: none; width: 24px; font-family: var(--font-display); font-style: italic; color: var(--accent-2); }
  .toc li.toc__sub a { padding-left: 36px; font-size: 15px; }
  .toc li a:hover { color: var(--ink); }
  .article__tags { margin-top: 40px; }
  .article__after { margin-top: 48px; display: grid; gap: 28px; }
  .article__related { margin-top: 88px; }
  .article__related-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; margin-bottom: 22px; }
  .article__related-head .blog-section__title { margin-bottom: 0; }

  .author { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center; padding: 20px 24px; }
  .author :global(.author__photo) { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; }
  .author > span { display: grid; gap: 4px; }
  .author__name { font-family: var(--font-display); font-size: 24px; font-weight: 600; }
  .author__pos { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--accent-2); }
  .author__short { font-size: 15px; color: var(--ink-2); }

  .faq { margin-top: 56px; }
  .faq h2 { font-family: var(--font-display); font-size: 34px; font-weight: 600; margin-bottom: 16px; }
  .faq details { border-top: 1px solid var(--line); padding: 18px 0; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-weight: 700; font-size: 18px; min-height: 44px; display: flex; align-items: center; }
  .faq details p { margin-top: 10px; color: var(--ink-2); font-size: 17px; line-height: 1.7; }

  .prose { font-size: 18px; line-height: 1.7; color: #d4d7dd; overflow-wrap: break-word; }
  .prose :global(h2) { font-family: var(--font-display); font-size: 34px; line-height: 1.1; font-weight: 600; color: var(--ink); margin: 48px 0 16px; }
  .prose :global(h3) { font-family: var(--font-display); font-size: 26px; line-height: 1.15; font-weight: 600; color: var(--ink); margin: 36px 0 12px; }
  .prose :global(h4) { font-size: 19px; font-weight: 700; color: var(--ink); margin: 28px 0 10px; }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(a) { color: var(--accent-2); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(blockquote) { margin: 32px 0; padding: 4px 0 4px 24px; border-left: 2px solid var(--accent-2); font-family: var(--font-display); font-style: italic; font-size: 24px; color: var(--ink); }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin: 0 0 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(img) { border-radius: 6px; outline: 1px solid var(--line); margin: 28px 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 40px 0; }
  .prose :global(code) { font-size: 0.9em; background: rgba(255, 255, 255, 0.06); padding: 2px 6px; border-radius: 4px; }
  .prose :global(pre) { overflow-x: auto; padding: 18px 20px; border-radius: var(--radius-sm); border: 1px solid var(--line); margin: 0 0 24px; font-size: 15px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 24px; font-size: 16px; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--line-2); padding: 10px 14px; text-align: left; }
  .prose :global(th) { color: var(--ink); background: var(--surface); }
  .prose :global(strong) { color: var(--ink); }
</style>
